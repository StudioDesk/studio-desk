{
  "name": "studio-desk",
  "version": "1.0.1",
  "license": "MIT",
  "homepage": "https://github.com/studiodesk/studio-desk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiodesk/studio-desk.git"
  },
  "bugs": {
    "url": "https://github.com/studiodesk/studio-desk/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/supervisor.mjs",
    "promote": "node scripts/promote.mjs",
    "setup-stable": "node scripts/setup-stable.mjs",
    "build": "node scripts/build-dashboard.mjs",
    "test": "node --test --test-timeout=120000 --test-force-exit test/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "test:dashboard": "tsc --noEmit && eslint --max-warnings 0 dashboard && vitest run --configLoader native",
    "format": "npx --yes prettier@3.3.3 --write .",
    "format:check": "npx --yes prettier@3.3.3 --check ."
  },
  "devDependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
